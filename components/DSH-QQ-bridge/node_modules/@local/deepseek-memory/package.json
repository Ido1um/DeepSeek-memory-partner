    "./facts": "./src/facts.mjs",
    "./longterm": "./src/longterm.mjs",
    "./scoring": "./src/scoring-runner.mjs",
    "./due": "./src/due.mjs",
    "./episode": "./src/episode.mjs",
    "./episode-ai": "./src/episode-ai.mjs",
